{
  "name": "java-project-runner-mcp",
  "version": "1.3.1",
  "description": "MCP server to build/start/stop/status/logs for registered Spring Boot Maven projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "java-project-runner-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "spring-boot",
    "maven",
    "java"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinsmoke-sanji59/java-project-runner-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vinsmoke-sanji59/java-project-runner-mcp/issues"
  },
  "homepage": "https://github.com/vinsmoke-sanji59/java-project-runner-mcp#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.9.2",
    "@types/proper-lockfile": "^4.1.4",
    "proper-lockfile": "^4.1.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
